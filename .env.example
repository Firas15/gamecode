# ── PostgreSQL ──
POSTGRES_DB=gamecode
POSTGRES_USER=gamecode_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Приложение (читается includes/db.php через getenv) ──
DB_HOST=db
DB_PORT=5432
DB_NAME=gamecode
DB_USER=gamecode_user
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Админка ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Публикация ──
WEB_PORT=80

# ── Чат-бот: нейросеть GigaChat (Сбер) ──
# «Ключ авторизации» из https://developers.sber.ru/studio → проект GigaChat API →
# «Настройки API» → «Получить ключ». Пусто — бот отвечает только из FAQ.
GIGACHAT_AUTH_KEY=
# Физлицо — GIGACHAT_API_PERS; ИП и юрлица — GIGACHAT_API_B2B (или _CORP)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat — самая дешёвая модель (Lite); GigaChat-Pro / GigaChat-Max умнее и дороже
GIGACHAT_MODEL=GigaChat
# Сколько запросов одновременно. Физлицу Сбер даёт 1 поток.
GIGACHAT_PARALLEL=1
# 0 — временно выключить нейросеть, не удаляя ключ
AI_ENABLED=1
# Вопросов к нейросети в час с одного IP и в сутки на весь сайт
AI_IP_HOURLY=30
AI_DAILY_LIMIT=2000
