# ── PostgreSQL ──
POSTGRES_DB=gamecode
POSTGRES_USER=gamecode_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Приложение (читается includes/db.php через getenv) ──
DB_HOST=db
DB_PORT=5432
DB_NAME=gamecode
DB_USER=gamecode_user
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Админка ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Публикация ──
WEB_PORT=80
