# ═══════════════════════════════════════════════════════════
#  РЕПОЗИТОРИЙ ПУБЛИЧНЫЙ — всё ниже наружу не уходит
# ═══════════════════════════════════════════════════════════

# ── Конфиги с паролями ──
config.php
admin/config.php

# ── Секреты и переменные окружения ──
data/app_secret.key
*.key
*.env
.env
.env.*
!.env.example

# ── Инфраструктура конкретного сервера ──
# Содержат IP, пути и схему развёртывания — в публичном репозитории
# это подсказка для того, кто будет ломать. Держим только локально.
DEPLOY.md
deploy.ps1

# ── Дампы и бэкапы БД (хеши паролей пользователей) ──
# Дампы с боевыми данными наружу не уходят, а структура базы — нужна:
# без неё новый разработчик не поднимет проект локально.
db/*
!db/schema.sql
!db/seed-demo.sql
!db/migrations/
!db/migrations/*.sql
# Наполнение магазина — не боевые данные, а список товаров с ценами.
# Лежит здесь, а НЕ в db/migrations/: entrypoint прогоняет миграции при
# каждом старте контейнера, и такой файл откатывал бы правки цен,
# сделанные на сервере через админку. Заливается вручную, один раз.
!db/shop-catalog.sql
*.dump
*.sql.gz

# ── Архивы деплоя ──
*.tar
*.tar.gz
*.zip

# ── Runtime-данные (создаются на сервере) ──
data/users.json
data/scores.json
data/admin_log.json
data/news.json

# ── Загруженные пользователями файлы ──
img/news/
# Аватары магазина — часть проекта, а не пользовательская загрузка:
# без них витрина и профиль показывают битые картинки.
img/avatars/*
!img/avatars/avatar*.png
# Аватары, добавленные через админку магазина, — тоже часть витрины,
# а не чья-то личная картинка: их видят все. Без них после деплоя
# товар в магазине есть, а изображения у него нет.
!img/avatars/custom-*.png

# ── PHP-утилиты и временные скрипты ──
fix_*.php
*_test.php
*_debug.php

# ── IDE и редакторы ──
.vscode/
.idea/
*.suo
*.user

# ── OS ──
Thumbs.db
.DS_Store
Desktop.ini

# ── Логи и кэш ──
*.log
*.cache
/cache/

# ── PHP Composer ──
vendor/
composer.lock
